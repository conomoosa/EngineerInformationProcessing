{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run Java",
            "type": "process",
            "command": "C:\\Program Files\\PowerShell\\7\\pwsh.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\RunJava.ps1",
                "-JavaFile",
                "${file}"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
